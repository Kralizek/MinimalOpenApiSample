@page "/"
@using System.Net.Http.Json
@using BookStore.Web.Models
@inject HttpClient Http

<PageTitle>Bookstore</PageTitle>

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0">Bookstore</h1>
        <button class="btn btn-primary" @onclick="OpenCreateModal" disabled="@isBusy">
            <i class="bi bi-plus-circle me-1"></i> Add Book
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th class="text-end">Price</th>
                    <th>Categories</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (books.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No books yet. Add your first one.</td>
                    </tr>
                }
                else
                {
                    @foreach (var book in books)
                    {
                        <tr>
                            <td>@book.Title</td>
                            <td>@book.Author</td>
                            <td class="text-end">@book.Price.ToString("C")</td>
                            <td>@string.Join(", ", (book.Categories ?? []).Select(GetCategoryLabel))</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" @onclick="() => BeginEdit(book)" disabled="@isBusy">Edit</button>
                                    <button class="btn btn-outline-danger" @onclick="() => DeleteBookAsync(book.Id)" disabled="@isBusy">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (isBookModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="book-modal-title" @onclick="CloseBookModal" @onkeydown="HandleModalKeydown">
        <div class="modal-dialog modal-dialog-centered" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <form @onsubmit="SaveBookAsync" @onsubmit:preventDefault="true">
                    <div class="modal-header">
                        <h2 class="modal-title h5 mb-0" id="book-modal-title">@(editingBookId is null ? "Add Book" : "Edit Book")</h2>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseBookModal" disabled="@isBusy"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Title</label>
                                <input class="form-control" @bind="bookForm.Title" @ref="titleInputRef" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Author</label>
                                <input class="form-control" @bind="bookForm.Author" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Price</label>
                                <input class="form-control" type="number" min="0" step="0.01" @bind="bookForm.Price" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Category</label>
                                <select class="form-select" @bind="selectedFormCategory">
                                    @foreach (var category in categories)
                                    {
                                        <option value="@category">@GetCategoryLabel(category)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseBookModal" disabled="@isBusy">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@isBusy">@(editingBookId is null ? "Create" : "Save")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private readonly List<BookDto> books = [];
    private readonly Category[] categories = [Category.Fiction, Category.NonFiction, Category.SciFi, Category.Fantasy];
    private EditableBook bookForm = new();
    private Category selectedFormCategory = Category.Fiction;
    private Guid? editingBookId;
    private bool isBookModalOpen;
    private bool shouldFocusTitle;
    private ElementReference titleInputRef;
    private bool isBusy;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadBooksAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldFocusTitle && isBookModalOpen)
        {
            shouldFocusTitle = false;
            await titleInputRef.FocusAsync();
        }
    }

    private async Task LoadBooksAsync()
    {
        isBusy = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var response = await Http.GetFromJsonAsync<SearchBooksResponse>("/books");
            books.Clear();
            books.AddRange(response?.Items ?? []);
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load books: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void OpenCreateModal()
    {
        editingBookId = null;
        bookForm = new EditableBook();
        selectedFormCategory = Category.Fiction;
        isBookModalOpen = true;
        shouldFocusTitle = true;
        errorMessage = null;
        successMessage = null;
    }

    private void BeginEdit(BookDto book)
    {
        editingBookId = book.Id;
        bookForm = new EditableBook
        {
            Title = book.Title,
            Author = book.Author,
            Price = book.Price,
            Isbn = book.Isbn
        };

        selectedFormCategory = book.Categories?.FirstOrDefault() ?? Category.Fiction;
        isBookModalOpen = true;
        shouldFocusTitle = true;
        errorMessage = null;
        successMessage = null;
    }

    private void CloseBookModal()
    {
        if (isBusy)
        {
            return;
        }

        isBookModalOpen = false;
        editingBookId = null;
        selectedFormCategory = Category.Fiction;
        bookForm = new EditableBook();
        shouldFocusTitle = false;
    }

    private void HandleModalKeydown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseBookModal();
        }
    }

    private async Task SaveBookAsync()
    {
        if (string.IsNullOrWhiteSpace(bookForm.Title) || string.IsNullOrWhiteSpace(bookForm.Author))
        {
            errorMessage = "Title and author are required.";
            return;
        }

        isBusy = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (editingBookId is null)
            {
                var createRequest = new CreateBookRequest
                {
                    Title = bookForm.Title,
                    Author = bookForm.Author,
                    Price = bookForm.Price,
                    Isbn = bookForm.Isbn,
                    Categories = [selectedFormCategory]
                };

                var createResponse = await Http.PostAsJsonAsync("/books", createRequest);
                createResponse.EnsureSuccessStatusCode();
                await LoadBooksAsync();
                successMessage = "Book created.";
            }
            else
            {
                var updateRequest = new UpdateBookRequest
                {
                    Title = bookForm.Title,
                    Author = bookForm.Author,
                    Price = bookForm.Price,
                    Isbn = bookForm.Isbn,
                    Categories = [selectedFormCategory]
                };

                var updateResponse = await Http.PutAsJsonAsync($"/books/{editingBookId.Value}", updateRequest);
                updateResponse.EnsureSuccessStatusCode();
                await LoadBooksAsync();
                successMessage = "Book updated.";
            }
            CloseBookModal();
        }
        catch (Exception ex)
        {
            errorMessage = editingBookId is null
                ? $"Could not create book: {ex.Message}"
                : $"Could not update book: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteBookAsync(Guid id)
    {
        isBusy = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var response = await Http.DeleteAsync($"/books/{id}");
            response.EnsureSuccessStatusCode();

            if (editingBookId == id)
            {
                CloseBookModal();
            }

            await LoadBooksAsync();
            successMessage = "Book deleted.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not delete book: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class EditableBook
    {
        public string Title { get; set; } = string.Empty;

        public string Author { get; set; } = string.Empty;

        public double Price { get; set; }

        public string? Isbn { get; set; }
    }

    private static string GetCategoryLabel(Category category)
    {
        return category switch
        {
            Category.Fiction => "Fiction",
            Category.NonFiction => "Non-Fiction",
            Category.SciFi => "Sci-Fi",
            Category.Fantasy => "Fantasy",
            _ => category.ToString()
        };
    }
}
